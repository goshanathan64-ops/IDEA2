[app]
title = NexGen Shop Manager
package.name = nexgenshopmanager
package.domain = org.nexgen
source.dir = .
source.include_exts = py,kv,png,jpg,jpeg,atlas,txt
version = 0.1.0
requirements = python3,kivy==2.3.0
orientation = portrait
fullscreen = 0
android.api = 34
android.minapi = 21
android.ndk = 25b
android.build_tools_version = 34.0.0
android.archs = arm64-v8a, armeabi-v7a
android.allow_backup = True

[buildozer]
log_level = 2
warn_on_root = 1
